{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.hakkai.kinetic": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": 1
        },
        {
          "wind": "query.property('hakkai:kind') == 1"
        },
        {
          "water": "query.property('hakkai:kind') == 2"
        },
        {
          "gear": "query.property('hakkai:kind') == 3"
        }
      ]
    }
  }
}
