{
  "format_version": "1.8.0",
  "animations": {
    "animation.hakkai.eclipse_colossus.idle": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "math.sin(query.anim_time * 90) * 2.3",
            0,
            "math.sin(query.anim_time * 45) * 1.1"
          ],
          "position": [
            0,
            "math.sin(query.anim_time * 90) * 0.18",
            0
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.anim_time * 60) * 2",
            "math.sin(query.anim_time * 35) * 4",
            0
          ]
        },
        "arm_l": {
          "rotation": [
            "math.sin(query.anim_time * 70) * 3",
            0,
            "-6 + math.sin(query.anim_time * 50) * 2"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.sin(query.anim_time * 70 + 180) * 3",
            0,
            "6 + math.sin(query.anim_time * 50 + 180) * 2"
          ]
        }
      }
    },
    "animation.hakkai.eclipse_colossus.walk": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            0,
            "math.sin(query.anim_time * 210) * 0.24",
            0
          ]
        },
        "arm_l": {
          "rotation": [
            "math.cos(query.anim_time * 210) * 16",
            0,
            -8
          ]
        },
        "arm_r": {
          "rotation": [
            "math.cos(query.anim_time * 210 + 180) * 16",
            0,
            8
          ]
        },
        "leg_0": {
          "rotation": [
            "math.cos(query.anim_time * 210) * 22",
            0,
            0
          ]
        },
        "leg_1": {
          "rotation": [
            "math.cos(query.anim_time * 210 + 180) * 22",
            0,
            0
          ]
        }
      }
    }
  }
}
